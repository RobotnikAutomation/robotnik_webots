<?xml version="1.0" ?>
<robot name="rbwatcher">
    <webots>
        <device reference="front_rgbd_camera_color" type="Camera">
          <ros>
            <enabled>true</enabled>
            <updateRate>25</updateRate>
            <alwaysOn>true</alwaysOn>
            <imageSuffix>/image_color</imageSuffix>
          </ros>
        </device>
        <device reference="top_ptz_camera" type="Camera">
          <ros>
            <enabled>true</enabled>
            <updateRate>25</updateRate>
            <alwaysOn>true</alwaysOn>
            <imageSuffix>/image_color</imageSuffix>
          </ros>
        </device>
        <device reference="top_ptz_camera_depth" type="RangeFinder">
          <ros>
            <enabled>true</enabled>
            <updateRate>25</updateRate>
            <alwaysOn>true</alwaysOn>
            <imageSuffix>/image</imageSuffix>
          </ros>
        </device>
        <plugin type="webots_ros2_driver::Ros2IMU">
          <enabled>true</enabled>
          <!-- Canonical IMU request; the 20 ms world step keeps physics at 50 Hz. -->
          <updateRate>100</updateRate>
          <topicName>imu/data</topicName>
          <alwaysOn>true</alwaysOn>
          <frameName>imu_link</frameName>
          <inertialUnitName>robot_imu_inertial</inertialUnitName>
          <gyroName>robot_imu_gyro</gyroName>
          <accelerometerName>robot_imu_accelerometer</accelerometerName>
        </plugin>
        <plugin type="webots_ros2_control::Ros2Control">
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
       </plugin>
    </webots>
    
    <ros2_control name="WebotsControl" type="system">
    <hardware>
      <plugin>webots_ros2_control::Ros2ControlSystem</plugin>
    </hardware>
    <joint name="robot_front_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="robot_front_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="robot_back_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="robot_back_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="robot_top_ptz_camera_pan_joint">
      <command_interface name="position">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="robot_top_ptz_camera_tilt_joint">
      <command_interface name="position">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
